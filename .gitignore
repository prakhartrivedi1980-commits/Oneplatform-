cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Temporary
tmp/
temp/
.cache/
EOF