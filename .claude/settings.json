{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull --ff-only origin main)",
      "Bash(git push origin main)",

      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",

      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",

      "Bash(npx prisma generate *)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma db push *)",
      "Bash(npx prisma studio *)",

      "Bash(docker compose ps *)",
      "Bash(docker compose up *)",
      "Bash(docker compose logs *)",
      "Bash(docker ps *)",

      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -f *)",

      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",

      "Bash(docker compose down -v *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",

      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db execute *)"
    ]
  }
}